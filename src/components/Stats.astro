---
import content from '../data/content.json';
---

<section class="section" id="stats">
  <div class="wrap">
    <div class="stats">
      {content.stats.map((stat) => (
        <div class="stat">
          <b>{stat.value}</b>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>