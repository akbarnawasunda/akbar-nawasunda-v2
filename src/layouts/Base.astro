---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import content from '../data/content.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Akbar Nawasunda — Official Website',
  description = 'Official website of Akbar Nawasunda aka DJ Akbar Remix. Breakbeat, Indo Bass, Jedag Jedug, Jungle Dutch.'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = '/favicon.svg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Person', 'MusicGroup'],
      '@id': `${Astro.site}#artist`,
      name: content.artist.name,
      alternateName: [content.artist.aka],
      url: Astro.site,
      genre: content.artist.genres,
      location: {
        '@type': 'Place',
        name: content.artist.location
      },
      sameAs: Object.values(content.socials).filter((url) => !String(url).startsWith('mailto:'))
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site,
      name: title,
      publisher: {
        '@id': `${Astro.site}#artist`
      }
    }
  ]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0d0221" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip ke konten</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #050508;
    --panel: #0d0d14;
    --line: rgba(255, 255, 255, 0.08);
    --txt: #f5f0ff;
    --dim: #a0a0b8;
    --neon: #ff00e4;
    --cyan: #00ffd5;
    --yellow: #ffd319;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --disp: 'Plus Jakarta Sans', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  body {
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(255, 0, 228, 0.08), transparent),
      radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1.5px),
      var(--bg);
    background-size: auto, 26px 26px, auto;
    color: var(--txt);
    font-family: var(--disp);
    line-height: 1.6;
    overflow-x: clip;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  .wrap {
    width: min(1100px, calc(100% - 44px));
    margin-inline: auto;
  }

  .skip {
    position: absolute;
    left: -999px;
    top: 10px;
    z-index: 999;
    background: var(--neon);
    color: #000;
    padding: 10px 14px;
    border-radius: 8px;
  }

  .skip:focus {
    left: 10px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(5, 5, 8, 0.82);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .logo {
    font-weight: 800;
    letter-spacing: 0.02em;
    font-size: 15px;
    white-space: nowrap;
  }

  .logo span {
    color: var(--neon);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: 8px 10px;
    border-radius: 8px;
    transition: 0.2s;
  }

  .nav a:hover {
    color: var(--neon);
    background: rgba(255, 0, 228, 0.08);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    padding: 12px 18px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #1f1038, #160828);
    color: var(--txt);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .btn:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn.primary {
    background: linear-gradient(180deg, var(--neon), #b8009e);
    border-color: rgba(255, 102, 217, 0.8);
    color: #fff;
    box-shadow: 0 8px 30px rgba(255, 0, 228, 0.28);
  }

  .btn.secondary {
    background: linear-gradient(180deg, var(--cyan), #00a8a0);
    border-color: rgba(102, 255, 225, 0.8);
    color: #031c1a;
    box-shadow: 0 8px 30px rgba(0, 255, 213, 0.22);
  }

  .section {
    padding: 88px 0;
    border-top: 1px solid var(--line);
  }

  .section-title {
    font-size: clamp(34px, 6vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .section-sub {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    margin-bottom: 28px;
  }

  .hero {
    padding: 120px 0 70px;
    position: relative;
    overflow: clip;
  }

  .badge {
    display: inline-flex;
    max-width: 100%;
    padding: 8px 14px;
    border: 1px solid rgba(255, 0, 228, 0.35);
    background: rgba(255, 0, 228, 0.08);
    color: var(--neon);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    margin-bottom: 22px;
  }

  .hero h1 {
    font-size: clamp(52px, 13vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hero h1 .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--neon);
  }

  .hero h1 .fill {
    background: linear-gradient(90deg, var(--neon), var(--cyan) 55%, var(--yellow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    color: var(--dim);
    font-family: var(--mono);
    font-size: clamp(11px, 1.7vw, 14px);
    letter-spacing: 0.12em;
    margin-bottom: 8px;
  }

  .aka {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 13px;
    margin-bottom: 28px;
  }

  .aka b {
    color: var(--cyan);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 34px;
  }

  .stat {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 14px;
    padding: 16px 14px;
  }

  .stat b {
    display: block;
    font-size: 22px;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .stat span {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .release-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }

  .release-tabs button {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    color: var(--dim);
    border-radius: 999px;
    padding: 10px 16px;
    font-family: var(--mono);
    font-size: 12px;
    cursor: pointer;
    transition: 0.2s;
  }

  .release-tabs button.active,
  .release-tabs button:hover {
    color: #fff;
    border-color: var(--neon);
    background: rgba(255, 0, 228, 0.12);
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }

  .rel-card {
    display: block;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #121019, #0b0b11);
    border-radius: 16px;
    padding: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .rel-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 0, 228, 0.5);
  }

  .rel-thumb {
    aspect-ratio: 1;
    border-radius: 12px;
    margin-bottom: 12px;
    background:
      linear-gradient(135deg, rgba(255, 0, 228, 0.16), rgba(0, 255, 213, 0.12)),
      #151221;
    background-size: cover;
    background-position: center;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .rel-meta {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .rel-card h3 {
    font-size: 16px;
    line-height: 1.35;
    margin-bottom: 8px;
  }

  .rel-type {
    display: inline-flex;
    border: 1px solid var(--line);
    color: var(--dim);
    border-radius: 6px;
    padding: 3px 8px;
    font-family: var(--mono);
    font-size: 10px;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
  }

  .plat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, #121019, #0b0b11);
    border-radius: 16px;
    padding: 18px 14px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .plat:hover {
    transform: translateY(-4px);
    border-color: var(--c, var(--neon));
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.25);
  }

  .plat b {
    font-size: 14px;
  }

  .plat span {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 11px;
  }

  .plat i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c, var(--neon));
    box-shadow: 0 0 14px var(--c, var(--neon));
  }

  .about-box {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 18px;
    padding: 24px;
    color: var(--dim);
  }

  .genre-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .genre {
    border: 1px solid rgba(0, 255, 213, 0.22);
    background: rgba(0, 255, 213, 0.05);
    color: var(--cyan);
    border-radius: 999px;
    padding: 8px 12px;
    font-family: var(--mono);
    font-size: 11px;
  }

  .form {
    display: grid;
    gap: 16px;
    max-width: 720px;
  }

  .form label {
    display: grid;
    gap: 8px;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .form input,
  .form select,
  .form textarea {
    width: 100%;
    min-height: 48px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 14px;
    color: var(--txt);
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .form textarea {
    min-height: 140px;
    resize: vertical;
  }

  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    border-color: var(--neon);
    background: rgba(255, 0, 228, 0.05);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-msg {
    min-height: 20px;
    color: var(--cyan);
    font-family: var(--mono);
    font-size: 12px;
  }

  .newsletter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 560px;
  }

  .newsletter input {
    flex: 1;
    min-width: 220px;
    min-height: 48px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 18px;
    color: var(--txt);
    outline: none;
  }

  .newsletter input:focus {
    border-color: var(--neon);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 28px 0 44px;
    margin-top: 70px;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 12px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a:hover {
    color: var(--neon);
  }

  .epk-hero {
    padding: 110px 0 40px;
  }

  .epk-label {
    color: var(--cyan);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    margin-bottom: 14px;
  }

  .panel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .panel {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 18px;
    padding: 20px;
  }

  .panel h2 {
    font-size: 18px;
    margin-bottom: 12px;
  }

  .panel p,
  .panel li {
    color: var(--dim);
  }

  .panel ul {
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }

  .notfound {
    min-height: 70vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 90px 0;
  }

  .notfound h1 {
    font-size: clamp(70px, 18vw, 180px);
    line-height: 0.9;
    color: var(--neon);
    margin-bottom: 18px;
  }

  @media (max-width: 900px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 0;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>