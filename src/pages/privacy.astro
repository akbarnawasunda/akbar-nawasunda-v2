---
import Base from '../layouts/Base.astro';
---

<Base
  title="Privacy Policy — Akbar Nawasunda"
  description="Privacy policy of akbarnawasunda.my.id"
>
  <section class="section">
    <div class="wrap">
      <h1 class="section-title">Privacy Policy</h1>
      <p class="section-sub">LAST UPDATED: 22 JUN 2026</p>

      <div class="about-box" style="display:grid;gap:18px;">
        <p>
          This site is built to be as light on your data as possible.
          No advertising, no tracking cookies, no selling data — ever.
        </p>

        <p>
          Newsletter: if you subscribe, your email address is sent via FormSubmit
          and used only to send release updates.
        </p>

        <p>
          Contact / collab form: your name, email and message are sent via FormSubmit
          to our inbox. Nothing is stored on the site's server.
        </p>

        <p>
          Third-party services may include Vercel, FormSubmit, Spotify, YouTube,
          SoundCloud, Apple Music, and iTunes Search for cover art / previews.
          Each service has its own privacy policy.
        </p>

        <p>
          You may request access, correction, or deletion of any personal data
          by contacting akbarnawasunda@gmail.com.
        </p>
      </div>
    </div>
  </section>
</Base>